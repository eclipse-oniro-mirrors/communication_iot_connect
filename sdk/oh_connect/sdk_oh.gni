import("../../iotc.gni")

iotc_sdk_oh_inc = [
  "$iotc_sdk_path/oh_connect/biz/include",
  "$iotc_sdk_path/oh_connect/config/include",
  "$iotc_sdk_path/oh_connect/define",
  "$iotc_sdk_path/oh_connect/main/include",
]

iotc_sdk_oh_src = [
  "$iotc_sdk_path/oh_connect/api/iotc_oh_connect.c",
  "$iotc_sdk_path/oh_connect/api/iotc_oh_device.c",
  "$iotc_sdk_path/oh_connect/biz/iotc_oh_ble_adv_data.c",
  "$iotc_sdk_path/oh_connect/biz/iotc_oh_softap_name.c",
  "$iotc_sdk_path/oh_connect/biz/iotc_oh_option.c",
  "$iotc_sdk_path/oh_connect/config/iotc_oh_config.c",
]

iotc_sdk_oh_def = []

if (iot_connect_feature_ailife_support) {
  iotc_sdk_oh_def += ["IOTC_CONF_AILIFE_SUPPORT=1"]
}

if (iot_connect_feature_ble_support) {
  iotc_sdk_oh_src += ["$iotc_sdk_path/oh_connect/api/iotc_oh_ble.c"]
}

if (iot_connect_feature_sle_support) {
  if (defined(ohos_lite)) {
    iotc_sdk_oh_src += ["$iotc_sdk_path/oh_connect/api/iotc_oh_sle.c",]
  }
  iotc_sdk_oh_src += [
    "$iotc_sdk_path/oh_connect/biz/iotc_oh_sle_adv_data.c",
  ]
}

if (iot_connect_feature_wifi_support) {
  iotc_sdk_oh_src += ["$iotc_sdk_path/oh_connect/api/iotc_oh_wifi.c"]
}
