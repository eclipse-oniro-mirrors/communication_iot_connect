import("//build/test.gni")

iotc_subsystem_name = "communication"
iotc_part_name = "iot_connect"

iotc_interface_path = "//foundation/communication/iot_connect/interfaces"
iotc_core_path = "//foundation/communication/iot_connect/core"
iotc_adapter_path = "//foundation/communication/iot_connect/adapter"

test_module = "coap_sess_utils_test"
module_out_path = iotc_part_name + "/" + iotc_part_name + "/" + test_module

ohos_unittest("CoapSessUtilsUnitTest") {
    subsystem_name = iotc_subsystem_name
    part_name = iotc_part_name
    module_out_path = module_out_path
    sources = [ "coap_sess_utils_test.cpp" ]
    include_dirs = [
        "$iotc_interface_path/kits/common",
        "$iotc_core_path/wifi/infrastructure/utils/include",
        "$iotc_core_path/wifi/infrastructure/transport/coap/codec/include",
        "$iotc_core_path/infrastructure/define",
        "$iotc_adapter_path/include",
    ]
    deps = [
        "//foundation/communication/iot_connect:iotc_shared",
    ]
    external_deps = [
        "bounds_checking_function:libsec_static",
        "cJSON:cjson",
        "googletest:gtest_main",
        "c_utils:utils",
        "hilog:libhilog",
    ]
}

test_module = "seq_num_utils_test"
module_out_path = iotc_part_name + "/" + iotc_part_name + "/" + test_module

ohos_unittest("SeqNumUtilsUnitTest") {
    subsystem_name = iotc_subsystem_name
    part_name = iotc_part_name
    module_out_path = module_out_path
    sources = [ "seq_num_utils_test.cpp" ]
    include_dirs = [
        "$iotc_interface_path/kits/common",
        "$iotc_core_path/wifi/infrastructure/utils/include",
        "$iotc_core_path/infrastructure/define",
        "$iotc_adapter_path/include",
    ]
    deps = [
        "//foundation/communication/iot_connect:iotc_shared",
    ]
    external_deps = [
        "bounds_checking_function:libsec_static",
        "cJSON:cjson",
        "googletest:gtest_main",
        "c_utils:utils",
        "hilog:libhilog",
    ]
}

test_module = "wifi_net_info_test"
module_out_path = iotc_part_name + "/" + iotc_part_name + "/" + test_module

ohos_unittest("WifiNetInfoUnitTest") {
    subsystem_name = iotc_subsystem_name
    part_name = iotc_part_name
    module_out_path = module_out_path
    sources = [ "wifi_net_info_test.cpp" ]
    include_dirs = [
        "$iotc_interface_path/kits/common",
        "$iotc_core_path/wifi/infrastructure/utils/include",
        "$iotc_core_path/infrastructure/define",
        "$iotc_adapter_path/include",
    ]
    deps = [
        "//foundation/communication/iot_connect:iotc_shared",
    ]
    external_deps = [
        "bounds_checking_function:libsec_static",
        "cJSON:cjson",
        "googletest:gtest_main",
        "c_utils:utils",
        "hilog:libhilog",
    ]
}

group("unittest") {
    testonly = true
    deps = [
        ":CoapSessUtilsUnitTest",
        ":SeqNumUtilsUnitTest",
        ":WifiNetInfoUnitTest",
    ]
}