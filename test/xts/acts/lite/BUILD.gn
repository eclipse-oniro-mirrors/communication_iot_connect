import("//test/xts/tools/lite/build/suite_lite.gni")

declare_args() {
  enable_ohos_test_xts_acts_use_iotc_ble = true
  enable_ohos_test_xts_acts_use_iotc_wifi = false
}


hctest_suite("ActsIotConnectTest") {
  suite_name = "acts"
  sources = [
    "iotc_oh_device_acts_test.c",
    "iotc_oh_connect_acts_test.c",
  ]

  if (enable_ohos_test_xts_acts_use_iotc_ble) {
    sources += ["iotc_oh_ble_acts_test.c"]
  }

  if (enable_ohos_test_xts_acts_use_iotc_wifi) {
    sources += ["iotc_oh_wifi_acts_test.c"]
  }

   include_dirs = [
    "//commonlibrary/utils_lite/include",
    "//foundation/communication/iot_connect/interfaces/kits/common",
    "//foundation/communication/iot_connect/interfaces/kits/oh_connect",
    "//foundation/communication/iot_connect/core/infrastructure/utils/include",
    "//foundation/communication/iot_connect/adapter/include",
    "//third_party/bounds_checking_function/include",
  ]
  deps = [
    "//foundation/communication/iot_connect:iotc_static",
    "//third_party/bounds_checking_function:libsec_shared",
    "//build/lite/config/component/cJSON:cjson_static",
  ]
  
  cflags = [ "-Wno-error" ]
}
