<configuration>
    <oatconfig>
        <licensefile>LICENSE</licensefile>
        <policylist>
            <policy name="projectPolicy" desc="">
                <policyitem
                    desc="Copyright (c) 2024-2024 ShenZhen Kaihong Device Co."
                    filefilter="copyrightPolicyFilter"
                    group="defaultGroup"
                    name="ShenZhen Kaihong Device Co."
                    path=".*"
                    rule="may"
                    type="copyright"/>
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="defaultFilter" desc="Files not to check">
                <filteritem type="filepath" name="LICENSE" desc="license file"/>
                <filteritem type="filepath" name="wukong100/cfg/fstab.uis7885" desc="配置文件，不能加其他注释"/>
                <filteritem type="filepath" name="wukong100/updater/config/fstab.updater" desc="配置文件，不能加其他注释"/>
                <filteritem type="filepath" name="wukong100/kernel/mkboot/bin/dtbTool" desc="打包工具，不能加其他注释"/>
                <filteritem type="filepath" name="wukong100/kernel/mkboot/bin/mkbootimg" desc="打包工具，不能加其他注释"/>
                <filteritem type="filepath" name="wukong100/kernel/mkboot/bin/mkdtimg" desc="打包工具，不能加其他注释"/>
                <filteritem type="filepath" name="wukong100/kernel/mkboot/lib64/libc++.so" desc="打包工具，不能加其他注释"/>
            </filefilter>
            <filefilter name="defaultPolicyFilter" desc="Filters for compatibility，license header policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="copyrightPolicyFilter" desc="Filters for copyright header policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="licenseFileNamePolicyFilter" desc="Filters for LICENSE file policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="readmeFileNamePolicyFilter" desc="Filters for README file policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="readmeOpenSourcefileNamePolicyFilter" desc="Filters for README.OpenSource file policies">
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="abcdefg/.*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>
            <filefilter name="binaryFileTypePolicyFilter" desc="Filters for binary file policies">
                <filteritem type="filename" name="*.ko" desc="ko"/>
                <filteritem type="filename" name="*.gpg" desc="gpg"/>
                <filteritem type="filename" name="*.bin" desc="bin"/>
                <filteritem type="filename" name="*.png" desc="png"/>
                <filteritem type="filename" name="*.jpg" desc="jpg"/>
                <filteritem type="filename" name="*.bmp" desc="bmp"/>
                <filteritem type="filename" name="*.a|*.so|*.bin|*.img|*.db|*.p7s" desc="Temp files"/>
                <!--filteritem type="filename" name="*.uvwxyz" desc="Describe the reason for filtering scan results"/-->
                <!--filteritem type="filepath" name="projectroot/[a-zA-Z0-9]{20,}.sh" desc="Temp files"/-->
            </filefilter>

        </filefilterlist>
        <licensematcherlist>
            <!--licensematcher name="uvwxyz License" desc="If the scanning result is InvalidLicense, you can define matching rules here. Note that quotation marks must be escaped.">
                <licensetext name="
                    uvwxyz license textA xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
				 " desc=""/>
                <licensetext name="
                    uvwxyz license textB xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
				 " desc=""/>
            </licensematcher-->
        </licensematcherlist>
    </oatconfig>
</configuration>